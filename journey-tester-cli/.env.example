# ─── Judge (LLM-as-judge) e persona simulada ────────────────────────────────
# Só é exigida por cenários que usam `judge` ou `persona`.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5

# ─── Adapter `http` (padrão: webhook da plataforma + graph sink) ────────────
# Endpoint que recebe o webhook do WhatsApp no ambiente de TESTE da plataforma.
PLATFORM_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/whatsapp

# O sink finge ser o graph.facebook.com. Aponte a base URL da Cloud API do
# ambiente de teste da plataforma para este endereço.
GRAPH_SINK_HOST=127.0.0.1
GRAPH_SINK_PORT=4020

# Se a plataforma valida X-Hub-Signature-256, informe o mesmo app secret dela.
WHATSAPP_APP_SECRET=

# Identificadores usados no payload de webhook simulado.
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_DISPLAY_PHONE_NUMBER=5511900000000

# ─── Spy das APIs externas da jornada (CRM, agenda, ERP) ────────────────────
# Aponte a base URL da API externa, no ambiente de teste da vonex.ai, para cá.
# Só sobe quando o cenário tem o bloco `apiSpy`.
API_SPY_HOST=127.0.0.1
API_SPY_PORT=4030

# ─── Adapter `cloud-api` (smoke test no canal real) ─────────────────────────
CLOUD_API_BASE_URL=https://graph.facebook.com/v21.0
CLOUD_API_TOKEN=
# Número de TESTE (o que faz papel de cliente), não o do bot.
TESTER_PHONE_NUMBER_ID=
# Número do bot que vai receber as mensagens.
BOT_PHONE_NUMBER=
# Webhook onde o número de teste recebe as respostas — precisa de túnel público.
INBOUND_WEBHOOK_HOST=0.0.0.0
INBOUND_WEBHOOK_PORT=4021
INBOUND_VERIFY_TOKEN=journey-tester
