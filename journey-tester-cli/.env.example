# Adapter usado quando o cenário não declara um.
DEFAULT_ADAPTER=evolution

# Chave da Evolution API — precisa bater com AUTHENTICATION_API_KEY do compose.
EVOLUTION_API_KEY=troque-esta-chave

# ─── Judge (LLM-as-judge) e persona simulada ────────────────────────────────
# Só é exigida por cenários que usam `judge` ou `persona`.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5

# ─── Adapter `http` (padrão: webhook da plataforma + graph sink) ────────────
# Endpoint que recebe o webhook do WhatsApp no ambiente de TESTE da plataforma.
PLATFORM_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/whatsapp

# O sink finge ser o graph.facebook.com. Aponte a base URL da Cloud API do
# ambiente de teste da plataforma para este endereço.
GRAPH_SINK_HOST=127.0.0.1
GRAPH_SINK_PORT=4020

# Se a plataforma valida X-Hub-Signature-256, informe o mesmo app secret dela.
WHATSAPP_APP_SECRET=

# Identificadores usados no payload de webhook simulado.
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_DISPLAY_PHONE_NUMBER=5511900000000

# ─── Spy das APIs externas da jornada (CRM, agenda, ERP) ────────────────────
# Aponte a base URL da API externa, no ambiente de teste da vonex.ai, para cá.
# Só sobe quando o cenário tem o bloco `apiSpy`.
API_SPY_HOST=127.0.0.1
API_SPY_PORT=4030

# ─── Adapters não-oficiais: z-api | evolution | uazapi ──────────────────────
# Não exigem nenhuma mudança na vonex.ai: um chip comum conversa com o número
# do bot como um cliente real faria. Use chip dedicado — risco de ban.
#
# Este projeto roda em Evolution API (self-hosted, `docker compose up -d`).
# BASE_URL por provedor:
#   evolution http://localhost:8080   ← padrão deste projeto
#   z-api     https://api.z-api.io
#   uazapi    https://SEU-SUBDOMINIO.uazapi.com
WA_PROVIDER_BASE_URL=http://localhost:8080
WA_PROVIDER_INSTANCE=teste
# z-api: token da instância · evolution: apikey · uazapi: token
WA_PROVIDER_TOKEN=
# Só Z-API, e só se o Client-Token estiver ativado na conta.
WA_PROVIDER_CLIENT_TOKEN=
# poll = sem túnel público (default). webhook = latência menor, exige exposição.
WA_PROVIDER_CAPTURE=poll
WA_PROVIDER_POLL_MS=1500
WA_PROVIDER_POLL_AMOUNT=20
# Escapes: se o contrato do seu provedor divergir do perfil embutido, ajuste
# aqui em vez de mexer em código.
WA_PROVIDER_SEND_PATH=
WA_PROVIDER_FETCH_PATH=
WA_PROVIDER_AUTH_HEADER=

# Número onde a jornada está publicada (destino das mensagens de teste).
# Usado pelos adapters não-oficiais e pelo cloud-api.
BOT_PHONE_NUMBER=

# ─── Adapter `cloud-api` (smoke test no canal real) ─────────────────────────
CLOUD_API_BASE_URL=https://graph.facebook.com/v21.0
CLOUD_API_TOKEN=
# Número de TESTE (o que faz papel de cliente), não o do bot.
TESTER_PHONE_NUMBER_ID=
# Número do bot que vai receber as mensagens.
BOT_PHONE_NUMBER=
# Template aprovado que abre a janela de 24h. Sem ele, a primeira mensagem
# fora da janela volta com erro 131047 da Meta.
CLOUD_API_OPEN_TEMPLATE=
CLOUD_API_OPEN_TEMPLATE_LANG=pt_BR
# Variáveis do corpo do template, na ordem, separadas por `|`. Vazio se o
# template não tem variável — mandar components num template sem variável dá 132000.
CLOUD_API_OPEN_TEMPLATE_PARAMS=
# Quanto esperar a resposta do bot ao template antes de mandar texto livre.
CLOUD_API_OPEN_TIMEOUT_MS=30000
# Webhook onde o número de teste recebe as respostas — precisa de túnel público.
INBOUND_WEBHOOK_HOST=0.0.0.0
INBOUND_WEBHOOK_PORT=4021
INBOUND_VERIFY_TOKEN=journey-tester
